{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkCam",
  "version": "1.0.0",
  "identifier": "com.linkcam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinkCam Companion",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
